; Engine configuration file.
config_version=5

[application]

config/name="Glimmerpit"
config/description="Up to four glimmers duel in a walled pit, over the network or against bots: the last one standing wins the round, three rounds win the match."
config/version="0.5.0"
run/main_scene="res://main.tscn"
config/icon="res://art/glimmer.png"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

