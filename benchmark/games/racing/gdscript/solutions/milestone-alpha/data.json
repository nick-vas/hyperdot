{
  "tables": {
    "tracks": {
      "file": "data/tracks.json",
      "id": "id",
      "fields": {
        "name": { "type": "string", "pattern": "^TRACK_[0-9]+$" },
        "laps": { "type": "int", "min": 1, "max": 5 },
        "width": { "type": "number", "min": 110, "max": 220 },
        "points": { "list": true },
        "checkpoints": { "type": "int", "min": 0, "list": true }
      }
    },
    "rivals": {
      "file": "data/rivals.json",
      "id": "id",
      "fields": {
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "pace": { "type": "number", "min": 0.7, "max": 0.99 },
        "line": { "type": "number", "min": -40, "max": 40 }
      }
    }
  }
}
