; Engine configuration file.
config_version=5

[application]

config/name="Bramblegate"
config/description="A small tower defence in a hedge garden: plant thorns, puffs and acorn mortars, and keep the pests away from the seed store."
config/version="0.5.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Bramblegate"

