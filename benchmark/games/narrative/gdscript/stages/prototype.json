    {
      "template": "fix-bug",
      "vars": {
        "report": "after they ask what is in the stranger's bag, the story stops: the text box is empty, no choice is offered, and they have to start the crossing again"
      },
      "edits": [
        {
          "file": "data/choices.json",
          "find": "{ \"id\": \"ask_cargo\", \"from\": \"crossing\", \"to\": \"cargo\",",
          "replace": "{ \"id\": \"ask_cargo\", \"from\": \"crossing\", \"to\": \"cargo_bag\","
        }
      ],
      "unchanged": [
        "test/unit/test_story.gd"
      ],
      "hidden": [
        "hidden/test_hidden_cargo.gd"
      ],
      "reference": "solutions/prototype/fix-bug",
      "decoy": "solutions/prototype/fix-bug-decoy"
    },
    {
      "template": "write-tests",
      "vars": {
        "subject": "Story class (scripts/story.gd: the choices offered, their needs and effects, the history and moving from node to node)",
        "file": "test/unit/test_story_rules.gd",
        "rules": "a choice is offered only when every one of its needs holds, raise adds one to a flag, set makes a flag 1 and clear makes it 0, a choice taken is added to the history and moves the story to the node it leads to, a choice that is not offered (out of another node, or with needs that do not hold) cannot be taken and changes nothing, and an ending offers no choice",
        "code": "scripts/story.gd"
      },
      "unchanged": [
        "scripts/story.gd"
      ],
      "mutantTests": [
        "test/unit/test_story_rules.gd"
      ],
      "mutants": [
        {
          "name": "a choice is offered whatever its needs",
          "file": "scripts/story.gd",
          "find": "return Conditions.holds(choice.needs, flags)",
          "replace": "return true"
        },
        {
          "name": "raise adds two",
          "file": "scripts/story.gd",
          "find": "_change(flag, int(flags.get(flag, 0)) + 1)",
          "replace": "_change(flag, int(flags.get(flag, 0)) + 2)"
        },
        {
          "name": "set leaves the flag as it was",
          "file": "scripts/story.gd",
          "find": "_change(flag, 1)",
          "replace": "_change(flag, int(flags.get(flag, 0)))"
        },
        {
          "name": "clear leaves the flag as it was",
          "file": "scripts/story.gd",
          "find": "_change(flag, 0)",
          "replace": "_change(flag, int(flags.get(flag, 0)))"
        },
        {
          "name": "a choice taken is not added to the history",
          "file": "scripts/story.gd",
          "find": "\thistory.append(choice_id)\n",
          "replace": ""
        },
        {
          "name": "a choice taken does not move the story",
          "file": "scripts/story.gd",
          "find": "node_id = choice.to",
          "replace": "node_id = node_id"
        },
        {
          "name": "any choice of the story can be taken",
          "file": "scripts/story.gd",
          "find": "if not can_choose(choice_id):",
          "replace": "if not graph.choices.has(choice_id):"
        }
      ],
      "reference": "solutions/prototype/write-tests"
    },
    {
      "template": "add-feature",
      "vars": {
        "feature": "once-only choices: a choice with \"once\": true in data/choices.json (read by StoryGraph into the choice's once) is offered only until it has been taken in this story; a new story offers it again, and a story carried on from Story.to_dict() still knows it was taken. Make the stranger's two questions at the crossing, ask_name and ask_cargo, once-only, so her trust cannot be won by asking her name over and over"
      },
      "hidden": [
        "hidden/test_hidden_once.gd"
      ],
      "reference": "solutions/prototype/add-feature"
    },
