      "template": "write-tests",
      "vars": {
        "subject": "Story class (scripts/Story.cs: the choices offered, their needs and effects, the history and moving from node to node)",
        "file": "test/StoryRulesTest.cs",
        "rules": "a choice is offered only when every one of its needs holds, raise adds one to a flag, set makes a flag 1 and clear makes it 0, a choice taken is added to the history and moves the story to the node it leads to, a choice that is not offered (out of another node, or with needs that do not hold) cannot be taken and changes nothing, and an ending offers no choice",
        "code": "scripts/Story.cs"
      },
      "unchanged": [
        "scripts/Story.cs"
      ],
      "mutantTests": [
        "test/StoryRulesTest.cs"
      ],
      "mutants": [
        {
          "name": "a choice is offered whatever its needs",
          "file": "scripts/Story.cs",
          "find": "return Conditions.Holds(choice.Needs, Flags);",
          "replace": "return true;"
        },
        {
          "name": "raise adds two",
          "file": "scripts/Story.cs",
          "find": "Change(flag, Flag(flag) + 1);",
          "replace": "Change(flag, Flag(flag) + 2);"
        },
        {
          "name": "set leaves the flag as it was",
          "file": "scripts/Story.cs",
          "find": "Change(flag, 1);",
          "replace": "Change(flag, Flag(flag));"
        },
        {
          "name": "clear leaves the flag as it was",
          "file": "scripts/Story.cs",
          "find": "Change(flag, 0);",
          "replace": "Change(flag, Flag(flag));"
        },
        {
          "name": "a choice taken is not added to the history",
          "file": "scripts/Story.cs",
          "find": "        History.Add(choiceId);\n",
          "replace": ""
        },
        {
