          "replace": "NodeId = NodeId;"
        },
        {
          "name": "any choice of the story can be taken",
          "file": "scripts/Story.cs",
          "find": "if (!CanChoose(choiceId))",
          "replace": "if (!Graph.HasChoice(choiceId))"
        }
      ],
      "reference": "solutions/prototype/write-tests"
    },
    {
      "template": "add-feature",
      "vars": {
        "feature": "once-only choices: a choice with \"once\": true in data/choices.json (read by StoryGraph into a new public bool property Once of the Choice class, with a getter and an init or set accessor) is offered only until it has been taken in this story; a new story offers it again, and a story carried on from Story.ToDict() through Story.FromDict still knows it was taken. Make the stranger's two questions at the crossing, ask_name and ask_cargo, once-only, so her trust cannot be won by asking her name over and over"
