{
  "frames": 1800,
  "args": [
    "--autoplay",
    "--seed=1",
    "--no-save"
  ],
  "rules": [
    {
      "event": "enemy_hit",
      "feedback": [
        "sfx"
      ],
      "withinMs": 100
    },
    {
      "event": "wick_hurt",
      "feedback": [
        "flash",
        "shake",
        "sfx"
      ],
      "withinMs": 100
    },
    {
      "event": "enemy_snuffed",
      "feedback": [
        "pop",
        "sfx"
      ],
      "withinMs": 100
    }
  ]
}
