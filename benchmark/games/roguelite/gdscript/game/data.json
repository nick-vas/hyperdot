{
  "tables": {
    "enemies": {
      "file": "data/enemies.json",
      "id": "id",
      "fields": {
        "name": { "type": "string", "pattern": "^ENEMY_[A-Z]+$" },
        "hp": { "type": "int", "min": 1, "max": 9 },
        "damage": { "type": "int", "min": 1, "max": 3 },
        "move_ticks": { "type": "int", "min": 6, "max": 30 },
        "attack_ticks": { "type": "int", "min": 30, "max": 120 },
        "sight": { "type": "int", "min": 2, "max": 10 },
        "embers": { "type": "int", "min": 0, "max": 9 }
      }
    },
    "floors": {
      "file": "data/floors.json",
      "id": "id",
      "fields": {
        "name": { "type": "string", "pattern": "^FLOOR_[0-9]+$" },
        "width": { "type": "int", "min": 24, "max": 44 },
        "height": { "type": "int", "min": 16, "max": 26 },
        "rooms": { "type": "int", "min": 2, "max": 10, "list": true },
        "room_size": { "type": "int", "min": 3, "max": 9, "list": true },
        "enemies": { "ref": "enemies", "list": true },
        "per_room": { "type": "int", "min": 0, "max": 4, "list": true }
      }
    }
  }
}
