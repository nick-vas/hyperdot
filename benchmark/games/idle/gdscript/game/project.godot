; Engine configuration file.
config_version=5

[application]

config/name="Duskhive"
config/description="An idle game of a moth hive at dusk: gather glow, raise wick moths, snails and star looms, and trade a whole night for the embers of dawn."
config/version="1.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://art/icon.png"

[autoload]

SafeArea="*res://ui/safe_area.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=false

