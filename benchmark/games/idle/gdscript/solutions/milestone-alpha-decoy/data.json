{
  "tables": {
    "producers": {
      "file": "data/producers.json",
      "id": "id",
      "fields": {
        "name": { "type": "string", "pattern": "^PRODUCER_[A-Z_]+$" },
        "cost": { "type": "number", "min": 1, "max": 1e12 },
        "growth": { "type": "number", "min": 1.05, "max": 1.3 },
        "rate": { "type": "number", "min": 0.1, "max": 1e9 }
      }
    },
    "upgrades": {
      "file": "data/upgrades.json",
      "id": "id",
      "fields": {
        "name": { "type": "string", "pattern": "^UPGRADE_[A-Z_]+$" },
        "target": { "type": "string", "pattern": "^(all|tap|[a-z_]+)$" },
        "multiplier": { "type": "number", "min": 1.1, "max": 10 },
        "cost": { "type": "number", "min": 1, "max": 1e15 },
        "needs": { "type": "int", "min": 0, "max": 500 }
      }
    },
    "economy": {
      "file": "data/economy.json",
      "id": "id",
      "fields": {
        "value": { "type": "number", "min": 0.01, "max": 1e9 },
        "note": { "type": "string" }
      }
    }
  }
}
