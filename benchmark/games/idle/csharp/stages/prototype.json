  "tasks": [
    {
      "template": "fix-bug",
      "vars": {
        "report": "Buy 10 asks more than the ten single prices added up: ten Glow Snails cost 2.80K glow at once, but 2.43K bought one at a time"
      },
      "edits": [
        {
          "file": "scripts/Economy.cs",
          "find": "return first * (Numbers.Power(g, n + amount) - Numbers.Power(g, n)) / (g - 1.0);",
          "replace": "return first * (Numbers.Power(g, n + amount + 1) - Numbers.Power(g, n + 1)) / (g - 1.0);"
        }
      ],
      "unchanged": [
        "test/EconomyTest.cs"
      ],
      "hidden": [
        "hidden/HiddenBulkCostTest.cs"
      ],
      "reference": "solutions/prototype/fix-bug",
      "decoy": "solutions/prototype/fix-bug-decoy"
    },
    {
      "template": "write-tests",
      "vars": {
        "code": "scripts/Economy.cs",
        "rules": "a producer's price is its base cost times its growth for each one owned, a purchase of several costs the sum of their single prices, a purchase spends its price and adds the amount bought, nothing is bought when the glow does not cover the price, production per second is each producer's rate times how many are owned, every 25 of one producer double its rate, production over a tick is the rate times the seconds, and the rate changes as soon as something is bought",
        "subject": "Economy class (scripts/Economy.cs: prices, purchases and production)",
        "file": "test/EconomyRulesTest.cs"
      },
      "unchanged": [
        "scripts/Economy.cs"
      ],
      "mutantTests": [
        "test/EconomyRulesTest.cs"
      ],
      "mutants": [
        {
          "name": "the price does not grow with the count",
          "file": "scripts/Economy.cs",
          "find": "        int n = Count(id);\n",
          "replace": "        int n = 0;\n"
        },
        {
          "name": "several at once cost the first price each",
          "file": "scripts/Economy.cs",
          "find": "return first * (Numbers.Power(g, n + amount) - Numbers.Power(g, n)) / (g - 1.0);",
          "replace": "return first * Numbers.Power(g, n) * amount;"
        },
        {
          "name": "a purchase spends nothing",
          "file": "scripts/Economy.cs",
          "find": "        Glow -= Cost(id, amount);\n",
          "replace": "        Glow -= 0.0;\n"
        },
        {
          "name": "a purchase the glow does not cover goes through",
          "file": "scripts/Economy.cs",
          "find": "Cost(id, amount) <= Glow",
          "replace": "Cost(id, amount) <= Glow * 2.0"
        },
        {
          "name": "a purchase of several adds one",
          "file": "scripts/Economy.cs",
          "find": "_owned[id] = Count(id) + amount;",
          "replace": "_owned[id] = Count(id) + 1;"
        },
        {
          "name": "production ignores the seconds",
          "file": "scripts/Economy.cs",
          "find": "double earned = Rate() * seconds;",
          "replace": "double earned = Rate();"
        },
        {
          "name": "the 25th of a producer does not double it",
          "file": "scripts/Economy.cs",
          "find": "(int)Math.Floor(Count(id) / (double)every)",
          "replace": "(int)Math.Floor(Count(id) / (double)(every * 1000))"
        },
        {
          "name": "the rate is not worked out again after a purchase",
          "file": "scripts/Economy.cs",
          "find": "        _owned[id] = Count(id) + amount;\n        _dirty = true;\n",
          "replace": "        _owned[id] = Count(id) + amount;\n"
        }
      ],
      "reference": "solutions/prototype/write-tests",
      "decoy": "solutions/prototype/write-tests-decoy"
    },
    {
      "template": "add-feature",
      "vars": {
        "feature": "a third buy mode, Buy max: the mode button (Safe/Column/Header/BuyModeButton) steps through Buy 1, Buy 10 and Buy max (the game's buy_mode 1, 10 and 0, then back to 1), and in Buy max each producer's row offers and buys as many as the glow pays for, through two new Economy methods: MaxAffordable(string id), an int, the most of that producer the glow pays for at its growing prices (0 when not even one), and BuyMax(string id), an int, which buys that many and returns how many"
      },
      "hidden": [
        "hidden/HiddenBuyMaxTest.cs"
      ],
      "reference": "solutions/prototype/add-feature",
      "decoy": "solutions/prototype/add-feature-decoy"
    },
